{
  "title": "Two-piece Game Boy-style badge case",
  "plan": {
    "title": "Two-piece Game Boy-style badge case",
    "summary": "A front bezel and rear shell fastened through all four PCB holes, with screw heads at the front and captive nuts at the back. A broad controls opening exposes all eight buttons; two side windows expose the LEDs. The rear shell clears the batteries and allows replacement after removal. Coordinates use the first photo: bottom-left is X=0, Y=0, including measurements on the mirrored back view. Opening estimates assume a roughly 95 × 145 mm PCB and must scale to your measured outline. Check the screw stack before printing: 16 mm screws may be too short for a full-depth rear shell, so recessed nut wells are proposed.",
    "parts": [
      {
        "name": "Front bezel",
        "printed": true,
        "purpose": "Game Boy-style face with LCD, controls, LED, USB-C, and switch openings."
      },
      {
        "name": "Rear shell",
        "printed": true,
        "purpose": "Protects rear electronics and batteries; incorporates recessed captive-nut wells at all four holes."
      },
      {
        "name": "Assembled badge PCB, LCD, and battery holder",
        "printed": false,
        "purpose": "Existing electronics enclosed by the case."
      },
      {
        "name": "Two AA batteries",
        "printed": false,
        "purpose": "Existing removable power source."
      },
      {
        "name": "Four M4 × 16 mm screws",
        "printed": false,
        "purpose": "Pass from the front through the case and PCB mounting holes."
      },
      {
        "name": "Four M4 hex nuts, nominally 7 mm across flats",
        "printed": false,
        "purpose": "Captured in the rear shell to secure the assembly."
      }
    ],
